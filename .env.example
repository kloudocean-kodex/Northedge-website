# Cloudflare Pages environment variables / bindings (do not commit real secrets)
REQUIRE_LEAD_DB=true
LEAD_TO_EMAIL=admin@northedgerealestate.com.au
LEAD_FROM_EMAIL=NorthEdge Website <website@northedgerealestate.com.au>
RESEND_API_KEY=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# D1 binding name: LEADS_DB

# VaultRE media-sync credentials — local/CI secret environment only.
# Do not expose these values to the browser or commit them to Git.
VAULTRE_API_KEY=
VAULTRE_ACCESS_TOKEN=
# Optional override; current AU core API default is used when blank.
VAULTRE_BASE_URL=
